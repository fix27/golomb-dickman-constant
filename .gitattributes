# Line-ending policy for the Golomb-Dickman artefacts.
#
# Every published text artefact is canonical LF: certificates, digits files,
# b-files, manifests, Python sources and documentation.  Without this file a
# Windows checkout with core.autocrlf=true rewrites them to CRLF, every
# SHA-256 in a SHA256SUMS.txt changes, and OEIS rejects the b-file.
#
# Checkpoint pickles are binary.  They are covered by *.pkl binary below and
# by the -text rules for the checkpoint directories, so Git never converts
# them.

* text=auto eol=lf

*.py   text eol=lf
*.txt  text eol=lf
*.md   text eol=lf
*.tex  text eol=lf
*.bib  text eol=lf
*.json text eol=lf
*.ps1  text eol=lf
*.sh   text eol=lf
*.v    text eol=lf
*.lean text eol=lf
*.yml  text eol=lf

# Checkpoint pickles are binary: never touch them.
*.pkl  binary
gd_rigorous_ckpt_*/** -text
ckpt_*/**             -text
__pycache__/**        -text

# Superseded releases are archived byte-for-byte.  Their meta_v12.json files
# record SHA-256 digests taken over CRLF sources, so normalising them here
# would silently invalidate that provenance.
30000/**      -text
30000-v2/**   -text
old_version/** -text
